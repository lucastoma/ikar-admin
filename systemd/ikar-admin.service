[Unit]
Description=ikar-admin (FastAPI)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=dev
WorkingDirectory=/workspace/ikar_apps/ikar-admin
EnvironmentFile=-/workspace/pod_config_ikarosopolis/.env
EnvironmentFile=-/workspace/ikar_apps/ikar-admin/.env
ExecStart=/usr/bin/bash /workspace/ikar_apps/ikar-admin/run.sh
Restart=always
RestartSec=2
KillMode=process
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target


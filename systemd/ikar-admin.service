[Unit]
Description=Ikaros Admin Panel (FastAPI)
After=network.target

[Service]
Type=simple
User=dev
WorkingDirectory=/workspace/ikar_apps/ikar-admin
ExecStart=/usr/bin/bash /workspace/ikar_apps/ikar-admin/run.sh
Restart=always
RestartSec=2
Environment=IKAR_ADMIN_PORT=8602
Environment=COMFYUI_PORT=18188
Environment=FILEBROWSER_PORT=8085
Environment=CODE_SERVER_PORT=8445

[Install]
WantedBy=multi-user.target
